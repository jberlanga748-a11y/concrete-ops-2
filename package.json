{
  "name": "concrete-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "verify:server": "node server/smoke-test.js",
    "backup:data": "node server/backup-export.js",
    "verify:backup": "node server/backup-export-test.js",
    "verify:customers": "node --test --test-concurrency=1 server/customer-api.test.js src/app-routing.test.js src/customer-utils.test.js src/customer-filter-layout.test.js",
    "verify:jobs": "node --test --test-concurrency=1 server/jobs-workflow.test.js src/job-utils.test.js src/app-routing.test.js",
    "verify:leads": "node --test --test-concurrency=1 server/lead-workflow.test.js src/lead-utils.test.js src/navigation-utils.test.js",
    "verify:roles": "node --test --test-concurrency=1 server/role-permissions.test.js shared/permissions.test.js",
    "verify:crew": "node --test --test-concurrency=1 server/crew-assignments.test.js",
    "verify:users": "node --test --test-concurrency=1 server/users-management.test.js src/user-utils.test.js",
    "verify:field-workspaces": "node --test --test-concurrency=1 src/field-workspace-utils.test.js",
    "verify:time": "node --test --test-concurrency=1 server/time-tracking.test.js src/time-utils.test.js",
    "verify:daily-reports": "node --test --test-concurrency=1 server/daily-reports.test.js src/report-utils.test.js src/app-routing.test.js",
    "verify:uploads": "node --test --test-concurrency=1 server/uploads.test.js src/upload-utils.test.js",
    "verify:safety": "node --test --test-concurrency=1 server/safety.test.js src/safety-utils.test.js shared/permissions.test.js",
    "verify:tool-checklist": "node --test --test-concurrency=1 server/tool-checklist.test.js src/tool-checklist-utils.test.js src/navigation-utils.test.js shared/permissions.test.js",
    "verify:calculator": "node --test --test-concurrency=1 server/calculator-results.test.js src/calculator-utils.test.js src/app-routing.test.js shared/permissions.test.js src/navigation-utils.test.js",
    "verify:pre-pour": "node --test --test-concurrency=1 server/pre-pour.test.js src/pre-pour-utils.test.js src/app-routing.test.js",
    "verify:post-pour": "node --test --test-concurrency=1 server/post-pour.test.js src/post-pour-utils.test.js src/app-routing.test.js",
    "verify:change-orders": "node --test --test-concurrency=1 server/change-orders.test.js src/change-order-utils.test.js",
    "verify:delivery-tickets": "node --test --test-concurrency=1 server/delivery-tickets.test.js src/delivery-ticket-utils.test.js",
    "verify:estimates": "node --test --test-concurrency=1 server/estimates.test.js src/estimate-utils.test.js src/app-routing.test.js shared/permissions.test.js",
    "verify:demo": "node --test --test-concurrency=1 server/demo.test.js",
    "verify:public-request": "node --test --test-concurrency=1 server/public-request.test.js",
    "verify:print-packets": "node --test --test-concurrency=1 src/print-packets.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0"
  }
}
