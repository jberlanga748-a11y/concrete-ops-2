{
  "name": "concrete-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "verify:server": "node server/smoke-test.js",
    "backup:data": "node server/backup-export.js",
    "verify:backup": "node server/backup-export-test.js",
    "verify:customers": "node --test --test-concurrency=1 server/customer-api.test.js src/app-routing.test.js src/customer-utils.test.js src/customer-filter-layout.test.js",
    "verify:jobs": "node --test --test-concurrency=1 server/jobs-workflow.test.js src/job-utils.test.js src/app-routing.test.js",
    "verify:leads": "node --test --test-concurrency=1 server/lead-workflow.test.js src/lead-utils.test.js src/navigation-utils.test.js",
    "verify:roles": "node --test --test-concurrency=1 server/role-permissions.test.js shared/permissions.test.js",
    "verify:crew": "node --test --test-concurrency=1 server/crew-assignments.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0"
  }
}
