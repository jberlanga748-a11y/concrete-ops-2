NODE_ENV=development
PORT=4000
DATA_DIR=./data
BACKUP_DIR=./data/backups
SEED_DEMO_DATA=true
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# BOOTSTRAP_ADMIN_NAME=Operations Admin
# BOOTSTRAP_ADMIN_ROLE=Administrator
SESSION_TTL_HOURS=168
SMOKE_TEST_PORT=4100
LOG_LEVEL=info
# Comma-separated explicit origins for browser API access in production.
# Production defaults to https://app.apexhq.online and https://concrete-ops-2.fly.dev when unset.
# CORS_ALLOWED_ORIGINS=https://app.apexhq.online,https://concrete-ops-2.fly.dev
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_REPLY_TO_DEFAULT=
EMAIL_API_URL=
