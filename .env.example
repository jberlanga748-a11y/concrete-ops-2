NODE_ENV=development
PORT=4000
DATA_DIR=./data
BACKUP_DIR=./data/backups
# SQLite is still the active runtime provider. Postgres/Supabase cutover requires
# the data-platform runbook and adapter verification before DATA_PROVIDER changes.
DATA_PROVIDER=sqlite
# DATABASE_URL=
# POSTGRES_DATABASE_URL=
# POSTGRES_SSL_MODE=require
# POSTGRES_POOL_MAX=5
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=apex-hq-uploads
SEED_DEMO_DATA=true
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please
# BOOTSTRAP_ADMIN_NAME=Operations Admin
# BOOTSTRAP_ADMIN_ROLE=Administrator
SESSION_TTL_HOURS=168
SMOKE_TEST_PORT=4100
LOG_LEVEL=info
# Number of trusted reverse proxy hops. Production defaults to 1 for Fly.io when unset.
# Keep 0 for direct local development unless testing forwarded client IP behavior.
# TRUST_PROXY_HOPS=1
# Comma-separated explicit origins for browser API access in production.
# Production defaults to https://app.apexhq.online and https://concrete-ops-2.fly.dev when unset.
# CORS_ALLOWED_ORIGINS=https://app.apexhq.online,https://concrete-ops-2.fly.dev
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_REPLY_TO_DEFAULT=
EMAIL_API_URL=
# Public browser token for Satellite Fence Takeoff Lite map rendering/search.
# Keep the real token in .env.local, Fly demo secrets, or preview env only.
VITE_MAPBOX_TOKEN=
