{
  "name": "Apex Family Care",
  "short_name": "Family Care",
  "description": "A private family care PWA for quick updates, family summaries, and doctor prep.",
  "id": "/family-care",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "/family-care",
  "scope": "/family-care",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F8FBFF",
  "theme_color": "#12312B",
  "categories": ["lifestyle", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add Update",
      "short_name": "Update",
      "description": "Open Apex Family Care to add a quick care update.",
      "url": "/family-care",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ]
}
